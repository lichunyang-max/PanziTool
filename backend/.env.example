# =============================================================================
# PanziPool 后端环境变量示例
# -----------------------------------------------------------------------------
# 用法：复制为 .env（或通过 shell/容器环境变量注入），按实际环境填写。
# 本文件仅作说明，不应包含真实密钥。
# =============================================================================

# 当前激活的 profile：留空（默认 H2 内存库，仅用于本地骨架验证）/ dev / prod
SPRING_PROFILES_ACTIVE=

# ---- 数据库（dev/prod profile 使用 PostgreSQL）----
# 开发环境默认指向本地 PostgreSQL，可按需覆盖
DB_URL=jdbc:postgresql://localhost:5432/panzipool
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 生产环境必须显式提供（application-prod.yml 无默认值，未配置将启动失败）
# DB_URL=jdbc:postgresql://<prod-host>:5432/panzipool
# DB_USERNAME=<prod-user>
# DB_PASSWORD=<prod-password>

# ---- CORS 允许的源（逗号分隔）----
# 开发：本地前端地址
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 生产：仅主站
# CORS_ORIGINS=https://www.panzipool.com
CORS_ORIGINS=http://localhost:3000

# ---- 服务端口（默认 8080）----
# SERVER_PORT=8080
