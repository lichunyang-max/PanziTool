# ============================================================================
# PanziPool 后端 .dockerignore
# ----------------------------------------------------------------------------
# 排除不需要进入 Docker 构建上下文的文件和目录，减小上下文体积、加速构建
# ============================================================================

# Maven 构建产物（容器内重新构建）
target

# 版本控制
.git
.gitignore

# IDE 配置
.vscode
.idea
*.iml
*.iws
*.ipr

# 日志文件
*.log
logs

# 环境变量文件（敏感信息不应进入镜像）
.env
.env.*

# 文档（构建不需要）
*.md

# 系统文件
.DS_Store
Thumbs.db
