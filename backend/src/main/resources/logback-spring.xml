<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  PanziPool Logback 配置
  ============================================================================
  生产环境(profile=prod): JSON 格式结构化日志, 输出到控制台(stdout)和文件
    控制台 JSON 日志由 docker logs 采集
    文件日志滚动存储到 logs/panzipool.log, 保留 30 天
    JSON 字段: @timestamp / level / logger_name / thread_name / message
  开发环境(profile=dev 或默认): 控制台彩色日志, 便于本地调试
  ============================================================================
-->
<configuration>

    <!-- ==================== 公共属性 ==================== -->
    <property name="LOG_DIR" value="logs"/>
    <property name="LOG_FILE" value="${LOG_DIR}/panzipool.log"/>
    <property name="LOG_PATTERN_COLORED"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{40}) - %msg%n"/>

    <!-- ==================== 非生产环境(dev / 默认): 彩色控制台日志 ==================== -->
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${LOG_PATTERN_COLORED}</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ==================== 生产环境(profile=prod): JSON 结构化日志 ==================== -->
    <springProfile name="prod">

        <!-- JSON 控制台输出(stdout, 由 docker logs 采集) -->
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- 隐藏不需要的字段, 精简 JSON 输出 -->
                <fieldNames>
                    <version>[ignore]</version>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
                <!-- 时间戳使用 ISO-8601 格式 -->
                <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampPattern>
                <!-- 包含 MDC 上下文(用于请求链路追踪) -->
                <includeMdc>true</includeMdc>
                <!-- 包含调用者信息(默认 false, 避免性能开销) -->
                <includeCallerData>false</includeCallerData>
            </encoder>
        </appender>

        <!-- JSON 文件输出(滚动归档, 保留 30 天) -->
        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_FILE}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <!-- 按天滚动, 文件名包含日期和序号 -->
                <fileNamePattern>${LOG_DIR}/panzipool.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <!-- 保留 30 天历史 -->
                <maxHistory>30</maxHistory>
                <!-- 单个归档文件最大 100MB -->
                <maxFileSize>100MB</maxFileSize>
                <!-- 所有归档文件总大小上限 2GB -->
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <fieldNames>
                    <version>[ignore]</version>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
                <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampPattern>
                <includeMdc>true</includeMdc>
                <includeCallerData>false</includeCallerData>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>
    </springProfile>

</configuration>
