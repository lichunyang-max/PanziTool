# ============================================================================
# PanziPool 前端 .dockerignore
# ----------------------------------------------------------------------------
# 排除不需要进入 Docker 构建上下文的文件和目录，减小上下文体积、加速构建
# ============================================================================

# 依赖目录（容器内重新安装，避免宿主机与容器平台不一致）
node_modules

# Nuxt 构建产物和临时目录（容器内重新生成）
.nuxt
.output
.nitro
.cache
.data
dist

# 版本控制
.git
.gitignore

# 测试文件（生产构建不需要）
test
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js

# IDE 和编辑器配置
.vscode
.idea
*.swp
*.swo
*~

# 日志和备份
*.log
backups

# 环境变量文件（敏感信息不应进入镜像）
.env
.env.*
!.env.example

# 文档（构建不需要）
*.md

# 代码格式化配置（构建不需要）
.prettierignore
.prettierrc
