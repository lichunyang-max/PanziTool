# ============================================================
# PanziPool 前端环境变量示例
# 复制本文件为 .env 并根据环境修改
# ============================================================

# --- API 地址配置 ---

# 服务端内网地址（SSR 阶段使用）
# 开发环境：http://localhost:8080
# Docker 内网：http://java-api:8080
NUXT_API_BASE=http://localhost:8080

# 客户端公开地址（浏览器可访问）
# 开发环境：http://localhost:8080
# 生产环境：https://www.panzipool.com/api
NUXT_PUBLIC_API_BASE=http://localhost:8080

# --- 第三方服务配置 ---

# 百度统计 ID（默认已内置，可通过环境变量覆盖）
# NUXT_PUBLIC_BAIDU_TONGJI_ID=06c8d960aee8a68f0a9a229ff4a18ceb

# 广告位 key（空字符串表示未配置，未配置时静默降级不影响布局）
# NUXT_PUBLIC_AD_SLOTS_HOME_TOP=
# NUXT_PUBLIC_AD_SLOTS_SIDEBAR=
# NUXT_PUBLIC_AD_SLOTS_TOOL_BOTTOM=
